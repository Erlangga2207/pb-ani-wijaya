# Template .env untuk server Hostinger (aniwijaya.com) — PRD-09.
# Salin ke .env di server: cp .env.production.example .env
# JANGAN isi nilai rahasia di file ini (file ini ikut di-commit). Isi hanya di .env server.

APP_NAME="PB. Ani Wijaya"
APP_ENV=production
# Diisi otomatis oleh: php artisan key:generate (baris ini wajib ada)
APP_KEY=
APP_DEBUG=false
APP_URL=https://aniwijaya.com
# Folder web publik di Hostinger (lihat deploy/FIRST_DEPLOY.md)
APP_PUBLIC_PATH=/home/u838281704/domains/aniwijaya.com/public_html

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=error

# Nama DB & user lengkap dengan prefix u838281704_ (dari hPanel → Databases)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Aplikasi tidak mengirim email; log saja.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@aniwijaya.com"
MAIL_FROM_NAME="${APP_NAME}"

# Super admin awal untuk "php artisan db:seed --force".
# Setelah berhasil login ke /panel: HAPUS baris ADMIN_PASSWORD dari .env server, lalu php artisan optimize.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Batas rendemen normal (%), opsional — default 50 dan 60.
# PRODUCTION_YIELD_MIN=50
# PRODUCTION_YIELD_MAX=60
